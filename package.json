{
  "name": "akali-app",
  "productName": "Akali Companion",
  "version": "1.5.1",
  "description": "Companion para Akali, Lulu, Twitch e Nami: builds, matchups, estatísticas, maestria, controle do cliente pelo celular e monitor de partida.",
  "author": "L Lawliet",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "build": {
    "appId": "com.lawliet.akalicompanion",
    "productName": "Akali Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "build/icon.png",
      "package.json",
      "build/license.txt",
      "!node_modules/uiohook-napi/prebuilds/{darwin,linux}*/**",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "Akali Companion",
      "uninstallDisplayName": "Akali Companion",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "AkaliCompanion-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AkaliCompanion-Portable-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ]
  }
}
