# Copie este arquivo para ".env" e cole sua chave.
# Pegue a chave em https://developer.riotgames.com (Development API Key expira a cada 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Porta do app (http://localhost:3000)
PORT=3000

# Opcional: pasta de instalação do LoL, se não for a padrão
# LOL_PATH=C:\Riot Games\League of Legends
